// Add this file's contents to the config generated by Grafana Cloud.
// It expects prometheus.remote_write.metrics_service and
// loki.write.grafana_cloud_loki to already exist in /etc/alloy/config.alloy.

prometheus.exporter.unix "raspberry" {
	set_collectors = [
		"cpu",
		"diskstats",
		"filesystem",
		"hwmon",
		"loadavg",
		"meminfo",
		"netdev",
		"pressure",
		"stat",
		"systemd",
		"thermal_zone",
		"time",
		"uname",
		"vmstat",
	]

	systemd {
		enable_restarts = true
		start_time      = true
	}
}

discovery.relabel "raspberry_host" {
	targets = prometheus.exporter.unix.raspberry.targets

	rule {
		target_label = "application"
		replacement  = "infrastructure"
	}

	rule {
		target_label = "service"
		replacement  = "raspberry-host"
	}

	rule {
		target_label = "host"
		replacement  = "raspberry"
	}

	rule {
		target_label = "environment"
		replacement  = "production"
	}
}

prometheus.scrape "raspberry_host" {
	targets         = discovery.relabel.raspberry_host.output
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.metrics_service.receiver]
}

prometheus.exporter.process "scraper" {
	track_children      = true
	track_threads       = false
	gather_smaps        = false
	recheck_on_scrape   = true
	remove_empty_groups = false

	matcher {
		name    = "scraper"
		cmdline = [".*uvicorn", "src\\.main:app"]
	}
}

discovery.relabel "scraper_process" {
	targets = prometheus.exporter.process.scraper.targets

	rule {
		target_label = "application"
		replacement  = "projeto-scrap"
	}

	rule {
		target_label = "service"
		replacement  = "scraper-process"
	}

	rule {
		target_label = "host"
		replacement  = "raspberry"
	}

	rule {
		target_label = "environment"
		replacement  = "production"
	}
}

prometheus.scrape "scraper_process" {
	targets         = discovery.relabel.scraper_process.output
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.metrics_service.receiver]
}

loki.process "application_logs" {
	stage.json {
		expressions = {
			level     = "level",
			timestamp = "@timestamp",
		}
	}

	stage.timestamp {
		source = "timestamp"
		format = "RFC3339Nano"
	}

	stage.labels {
		values = {
			level = "",
		}
	}

	forward_to = [loki.write.grafana_cloud_loki.receiver]
}

loki.source.file "scraper" {
	targets = [
		{
			__path__    = "/home/bielsolosos/.pm2/logs/scrap-*.log",
			application = "projeto-scrap",
			service     = "scraper",
			host        = "raspberry",
			environment = "production",
		},
	]
	tail_from_end = true
	forward_to    = [loki.process.application_logs.receiver]

	file_match {
		enabled     = true
		sync_period = "10s"
	}
}

// PM2 daemon logs expose process exits and automatic restarts.
loki.source.file "pm2" {
	targets = [
		{
			__path__    = "/home/bielsolosos/.pm2/pm2.log",
			application = "infrastructure",
			service     = "pm2",
			host        = "raspberry",
			environment = "production",
		},
	]
	tail_from_end = true
	forward_to    = [loki.write.grafana_cloud_loki.receiver]

	file_match {
		enabled     = true
		sync_period = "10s"
	}
}

// Kernel logs make host OOM kills queryable in Loki.
loki.source.journal "kernel" {
	matches        = "_TRANSPORT=kernel"
	max_age        = "12h"
	format_as_json = true
	labels         = {
		application = "infrastructure",
		service     = "kernel",
		host        = "raspberry",
		environment = "production",
	}
	forward_to = [loki.write.grafana_cloud_loki.receiver]
}
