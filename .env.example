APP_NAME=Marketplace Scraper Service
APP_ENV=development
PORT=8001
HOST=127.0.0.1
LOG_LEVEL=INFO

# Basic Authentication Credentials
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=admin

# Database Configuration (SQLite async)
DATABASE_URL=sqlite+aiosqlite:///./data/scraper.db

# Scraping Engine Settings
DEFAULT_TIMEOUT_SECONDS=15
MAX_RETRIES=2
ENABLE_PLAYWRIGHT_FALLBACK=true
HEADLESS=true

# Job Queue Settings (serialized via SQLite)
SCRAPE_WORKER_CONCURRENCY=1
SCRAPE_WORKER_POLL_INTERVAL=1.0
SCRAPE_JOB_TIMEOUT_SECONDS=300
